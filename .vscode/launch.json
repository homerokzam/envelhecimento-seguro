{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Aspire AppHost",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build apphost",
      "program": "${workspaceFolder}/aspire/EnvelhecimentoSeguro.AppHost/bin/Debug/net10.0/EnvelhecimentoSeguro.AppHost.dll",
      "cwd": "${workspaceFolder}/aspire/EnvelhecimentoSeguro.AppHost",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true",
        "ASPNETCORE_URLS": "http://localhost:15150",
        "PYTHON_EXECUTABLE": "${workspaceFolder}/backend/webapi-python/.venv/bin/python"
      }
    }
  ]
}